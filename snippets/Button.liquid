{% comment %}
   Renders product buttons.
   Accepts:
   - href: {String}
   - style: {String}
   - type: {String}
   - classes: {String}
   - id: {String}.
   - target: {String}
  - content: {String}
   Usage:
   {% render 'Button', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true %}
{% endcomment %}
{% liquid
  if href != blank
    assign element = 'a'
  else
    assign element = 'button'
  endif

  case style
    when 'primary'
      assign button_style = 'button--primary'
    else
      assign button_style = 'button--secondary'
  endcase

  assign button_classes = ' tw-relative' | prepend: classes
%}
<{{ element }}
  class='button {{ button_style }} {{ button_classes | escape }}'
  {% if id != blank %}
    id='{{ id }}'
  {% endif %}
  {% if href != blank %}
    href='{{ href }}'
  {% endif %}
  {% if type != blank %}
    type='{{ type }}'
  {% endif %}
  {% if name != blank %}
    name='{{ name }}'
  {% endif %}
  {% if target != blank %}
    target='{{ target }}'
  {% endif %}
>
  <div class='button-inner'>
    <span class='button-label tw-absolute tw-top-0 tw-left-0 tw-w-full tw-h-full tw-flex tw-justify-center tw-items-center tw-font-subheadline tw-uppercase tw-text-[12px] tw-tracking-wider'>
      {{ content }}
    </span>
  </div>
</{{ element }}>
