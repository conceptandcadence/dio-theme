{% if request.path contains 'apps/bundles' %}
  <style>
    @media screen and (max-width: 768px) {
      .section.is-width-wide .container.has-limit {
        padding-top: 30px;
        width: 90%;
      }
    }
  </style>
  <script>
    let kitenzoTitleInterval = setInterval(function () {
      let bundleTitle = document.querySelector('h2.Text-module__kitenzo-text-component span')?.innerHTML;
      if (bundleTitle) {
        console.log(bundleTitle);
        window.bundleTitle = bundleTitle;
        clearInterval(kitenzoTitleInterval);
      }
    }, 100);

    let kitenzoSummaryInterval = setInterval(function () {
      let bundleTitle = document.querySelector('h2.Text-module__kitenzo-text-component span')?.innerHTML;
      window.bundleTitle = bundleTitle;
      if (document.querySelector('.KitSummaryHeader-module__kitenzo-container') && window.bundleTitle) {
        if (document.querySelector('.KitSummaryHeader-module__kitenzo-container')) {
          document.querySelector(
            '.KitSummaryHeader-module__kitenzo-container',
          ).innerHTML = `Your ${window.bundleTitle}`;
        }

        if (window.bundleTitle?.includes('Sampler')) {
          document.querySelector('.Modal-module__kitenzo-modal-open').classList.add('matchbox-sampler');
        }
        if (window.bundleTitle?.includes('Bacchus')) {
          document.querySelector('.Modal-module__kitenzo-modal-open').classList.add('gift-tubes');
        }
        clearInterval(kitenzoSummaryInterval);
      }
    }, 100);
  </script>
{% endif %}

